--><script type="application/javascript">
// END BLOCK

config = {
    xtermjs : "{{cookiecutter.xtermjs}}" ,
    _sdl2 : "canvas",
    user_canvas : 0,
    user_canvas_managed : 0,
    gui_divider : 2,
    ume_block : {{cookiecutter.ume_block}},
    can_close : {{cookiecutter.can_close}},
    archive : "{{cookiecutter.archive}}",
    gui_debug : 2,
    cdn : "{{cookiecutter.cdn}}",
    autorun : {{cookiecutter.autorun}},
    PYBUILD : "{{cookiecutter.PYBUILD}}",
    fb_ar   :  1.77,
    fb_width : "{{cookiecutter.width}}",
    fb_height : "{{cookiecutter.height}}"
}

// ---- Loading screen helpers (called from the Python block and from the game) ----
// Most of the wait on phones is the Python runtime starting up, not downloading,
// so the bar follows real loading stages and creeps forward between them.
const mango_t0 = performance.now()
window.mango_marks = []
const STAGES = {
    "page loaded":      [8,  "Downloading Python..."],
    "python started":   [70, "Unpacking Mango..."],
    "game unpacked":    [82, "Getting the cage ready..."],
    "preload done":     [88, "Waking Mango up..."],
    "starting main.py": [92, "Waking Mango up..."],
    "first frame":      [100, "Here he is!"],
}
const CEILING = {8: 66, 70: 80, 82: 87, 88: 91, 92: 99, 100: 100}
let mango_progress = 2, mango_floor = 2
function mango_mark(stage) {
    const t = ((performance.now() - mango_t0) / 1000).toFixed(1)
    mango_marks.push([stage, t])
    console.log(`[mango] ${t}s ${stage}`)
    if (STAGES[stage]) {
        mango_floor = STAGES[stage][0]
        mango_progress = Math.max(mango_progress, mango_floor)
        mango_status(STAGES[stage][1])
    }
}
function mango_status(text) {
    const el = document.getElementById("splash-status")
    if (el) el.textContent = text
}
function mango_show_play() {
    mango_status("Ready!")
    document.getElementById("splash-bar").hidden = true
    document.getElementById("play").hidden = false
}
// the game calls this after drawing its first frame
function mango_ready() {
    mango_mark("first frame")
    window.__mango_started = true
    const fill = document.getElementById("splash-fill")
    if (fill) fill.style.width = "100%"
    setTimeout(() => document.getElementById("splash").classList.add("gone"), 250)
    setTimeout(() => document.getElementById("splash").remove(), 900)
}
// main.py calls this if the game crashes while starting
function mango_error(details) {
    console.error("[mango] crashed:", details)
    mango_status("Sorry, Mango couldn't start. Try reloading the page.")
    const bar = document.getElementById("splash-bar")
    if (bar) bar.hidden = true
}
// pygbag calls show_infobox(); our splash replaces the infobox
function show_infobox() {}

setInterval(() => {
    const fill = document.getElementById("splash-fill")
    if (!fill || window.__mango_started) return
    // ease toward (but never past) the next stage so the bar never looks frozen
    const ceiling = CEILING[mango_floor] ?? 99
    mango_progress += (ceiling - mango_progress) * 0.02
    fill.style.width = mango_progress.toFixed(1) + "%"
}, 100)

if ("serviceWorker" in navigator && window.isSecureContext) {
    navigator.serviceWorker.register("sw.js").catch((e) => console.warn("service worker", e))
}
</script>

