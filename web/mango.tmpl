    <meta property="og:description" content="Take care of Mango the lovebird, right in your browser.">
    <meta property="og:image" content="icon-512.png">
    <link rel="manifest" href="manifest.webmanifest">
    <link rel="icon" type="image/png" href="favicon.png">
    <link rel="apple-touch-icon" href="icon-192.png">
    <link rel="preconnect" href="https://pygame-web.github.io" crossorigin>

    <style>
        html, body {
            margin: 0;
            height: 100%;
            background: #1b1310;
            overflow: hidden;
            /* no double-tap zoom, pull-to-refresh, text selection, or grey tap flashes */
            touch-action: none;
            overscroll-behavior: none;
            user-select: none;
            -webkit-user-select: none;
            -webkit-tap-highlight-color: transparent;
            font-family: "Trebuchet MS", system-ui, -apple-system, sans-serif;
        }

        /* the canvas *must not* have any border or padding, or mouse coords will be wrong */
        canvas.emscripten {
            border: 0 none;
            background-color: transparent;
            width: 100%;
            height: 100%;
            padding: 0;
            margin: 0 auto;
            position: absolute;
            inset: 0;
            z-index: 5;
            outline: none;
        }

        #splash {
            position: fixed;
            inset: 0;
            z-index: 100;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 14px;
            color: #fff;
            background: radial-gradient(circle at 50% 35%, #3a2a1f 0%, #1b1310 70%);
            transition: opacity .5s ease;
        }
        #splash.gone { opacity: 0; pointer-events: none; }
        #splash img {
            width: 112px;
            height: 112px;
            image-rendering: pixelated;
            animation: bob 1.6s ease-in-out infinite;
            filter: drop-shadow(0 8px 12px rgba(0,0,0,.45));
        }
        @keyframes bob { 50% { transform: translateY(-10px) rotate(-3deg); } }
        #splash h1 { margin: 0; font-size: clamp(22px, 5vw, 34px); letter-spacing: .3px; text-align: center; }
        #splash h1 span { color: #ffc93c; }
        #splash-status { min-height: 1.2em; font-size: 14px; color: #d9c8b8; }
        #splash-bar {
            width: min(320px, 70vw);
            height: 10px;
            border-radius: 99px;
            background: rgba(255,255,255,.12);
            overflow: hidden;
        }
        #splash-fill {
            width: 2%;
            height: 100%;
            border-radius: 99px;
            background-image: linear-gradient(90deg, #ff9f1c, #ffd45c, #ff9f1c);
            transition: width .25s ease;
            background-size: 200% 100%;
            animation: shimmer 1.2s linear infinite;
        }
        @keyframes shimmer { from { background-position: 200% 0; } to { background-position: 0 0; } }
        #play {
            margin-top: 6px;
            padding: 16px 44px;
            font: inherit;
            font-size: 22px;
            font-weight: bold;
            color: #2b1a0e;
            background: linear-gradient(180deg, #ffd45c, #ff9f1c);
            border: 0;
            border-radius: 99px;
            box-shadow: 0 6px 0 #b8650f, 0 12px 24px rgba(0,0,0,.35);
            cursor: pointer;
            animation: pulse 1.4s ease-in-out infinite;
        }
        #play:active { transform: translateY(4px); box-shadow: 0 2px 0 #b8650f; }
        @keyframes pulse { 50% { transform: scale(1.05); } }
        #splash small { position: absolute; bottom: max(14px, env(safe-area-inset-bottom)); color: #8d7b6c; font-size: 12px; }

        /* phones held upright: the game is wide, so suggest turning sideways */
        #rotate {
            display: none;
            position: fixed;
            inset: auto 0 0 0;
            z-index: 50;
            padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
            text-align: center;
            color: #fff;
            background: rgba(0,0,0,.72);
            font-size: 15px;
        }
        @media (orientation: portrait) and (pointer: coarse) { #rotate { display: block; } }

        /* pygbag's own widgets: keep them out of sight unless debugging */
        #infobox, #transfer { position: fixed; left: -9999px; }
    </style>

    <script src="{{cookiecutter.cdn}}/browserfs.min.js"></script>
